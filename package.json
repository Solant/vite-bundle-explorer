{
  "name": "vite-bundle-explorer",
  "description": "Bundle analyzer and visualizer tool for Vite",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @vite-bundle-explorer/ui dev",
    "build": "pnpm lint && pnpm typecheck && pnpm run -r build && pnpm clean && cp -r packages/plugin/dist dist-plugin && cp -r packages/ui/dist-ui dist-ui",
    "clean": "rm -rf dist-plugin && rm -rf dist-ui",
    "typecheck": "pnpm run -r typecheck",
    "lint": "eslint"
  },
  "homepage": "https://github.com/Solant/vite-bundle-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solant/vite-bundle-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/Solant/vite-bundle-explorer/issues"
  },
  "keywords": [
    "vite",
    "bundle",
    "explorer",
    "analyzer",
    "visualizer",
    "plugin",
    "size",
    "analysis",
    "optimization",
    "stats",
    "visualization",
    "import-graph",
    "dependency-graph",
    "treemap",
    "rollup",
    "performance",
    "build"
  ],
  "exports": {
    "./plugin": {
      "types": "./dist-plugin/stats-plugin.d.mts",
      "import": "./dist-plugin/stats-plugin.mjs"
    }
  },
  "files": [
    "dist-ui/index.html",
    "dist-ui/assets",
    "dist-plugin/stats-plugin.mjs",
    "dist-plugin/stats-plugin.d.mts",
    "bin/index.js"
  ],
  "bin": {
    "vite-bundle-explorer": "./bin/index.js"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@unocss/eslint-config": "^66.5.4",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.5.1",
    "eslint-stylistic-airbnb": "^2.0.1",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.2"
  }
}
