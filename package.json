{
  "name": "vite-bundle-explorer",
  "description": "Bundle analyzer and visualizer tool for Vite",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run -r build && cp -r packages/plugin/dist dist-plugin && cp -r packages/ui/dist-ui dist-ui",
    "clean": "rm -rf dist-plugin && rm -rf dist-ui",
    "format": "prettier src plugin bin vite.config.ts --write",
    "lint": "eslint",
    "release": "pnpm build && pnpm changelogen --release --push && pnpm publish"
  },
  "homepage": "https://github.com/Solant/vite-bundle-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solant/vite-bundle-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/Solant/vite-bundle-explorer/issues"
  },
  "keywords": [
    "vite",
    "bundle",
    "explorer",
    "analyzer",
    "visualizer",
    "plugin",
    "size",
    "analysis",
    "optimization",
    "stats",
    "visualization",
    "import-graph",
    "dependency-graph",
    "treemap",
    "rollup",
    "performance",
    "build"
  ],
  "exports": {
    "./plugin": {
      "types": "./dist-plugin/stats-plugin.d.mts",
      "default": "./dist-plugin/stats-plugin.mjs"
    }
  },
  "files": [
    "dist-ui/index.html",
    "dist-ui/assets",
    "dist-plugin/stats-plugin.js",
    "dist-plugin/stats-plugin.d.ts",
    "bin/index.js"
  ],
  "bin": {
    "vite-bundle-explorer": "./bin/index.js"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@types/node": "^24.0.13",
    "eslint": "^9.38.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.5.1",
    "eslint-stylistic-airbnb": "^2.0.1",
    "globals": "^16.4.0",
    "tsdown": "^0.23.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.2"
  }
}
